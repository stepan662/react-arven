{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "rootDir": "./",
    "noEmit": false,
    "jsx": "react-jsx",
    "sourceMap": false,
    "declarationMap": false,
    "inlineSources": false,
    "inlineSourceMap": false,
    "paths": {
      "@test-utils": ["./tests/test-utils.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*"]
}
