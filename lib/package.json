{
  "name": "react-arven",
  "version": "2.2.1",
  "description": "A React provider helper with stable actions for context-based state.",
  "license": "MIT",
  "author": "Stepan Granat <stepan.granat@gmail.com>",
  "repository": {
    "url": "https://github.com/stepan662/react-arven"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.min.mjs",
  "jsdelivr": "./dist/index.min.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c ../rollup.config.js",
    "tsc": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^23.0.1",
    "vitest": "^1.0.4"
  }
}
